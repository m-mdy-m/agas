{
  "name": "@medishn/agas",
  "version": "2.0.2",
  "description": "Agas is a minimal, HTTP client for the Terminal.",
  "type": "module",
  "main": "dist/index",
  "files": ["dist","README.md","LICENSE"],
  "scripts": {
    "build": "bun build ./src/index.ts  --outdir ./dist --minify --format esm --target bun",
    "build:cli": "bun build ./bin/agas.ts --outfile ./dist/bin/agas.js --minify --format esm --target bun",
    "build:all":"bun run build && bun run build:cli",
    "test": "bun test ./tests/*",
    "test:integration":"bun test ./tests/integration*",
    "clean": "rm -rf dist",
    "dev": "bun run ./bin/agas",
    "release": "npm publish",
    "docker:build": "docker build -t bitsgenix/agas:latest .",
    "docker:run": "docker run --rm bitsgenix/agas",
    "docker:publish": "docker push bitsgenix/agas:latest",
    "npm:pack": "npm pack",
    "build:binary": "bun run scripts/build-binary.ts",
    "package:binaries": "bun run scripts/package-binaries.ts",
    "release:binaries": "bun run build:binary && bun run package:binaries"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "@glandjs/emitter": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/m-mdy-m/agas"
  },
  "bugs": {
    "url": "https://github.com/m-mdy-m/agas/issues"
  },
  "homepage": "https://github.com/m-mdy-m/agas#readme",
  "keywords": [
    "http",
    "client",
    "cli",
    "rest",
    "api",
    "request",
    "fetch",
    "curl",
    "httpie",
    "terminal",
    "bun"
  ],
  "author": {
    "name": "Mahdi",
    "email": "bitsgenix@gmail.com",
    "url": "https://github.com/m-mdy-m"
  },
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/m-mdy-m"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
